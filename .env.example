# ============================================================
# scylla2ch environment variables
# Copy to .env and fill in real values
# ============================================================

# --- ScyllaDB Cloud ---
SCYLLA_HOST_0=node-0.example.clusters.scylla.cloud
SCYLLA_HOST_1=node-1.example.clusters.scylla.cloud
SCYLLA_HOST_2=node-2.example.clusters.scylla.cloud
SCYLLA_PORT=9142
SCYLLA_KEYSPACE=my_keyspace
SCYLLA_USER=scylla
SCYLLA_PASSWORD=
SCYLLA_DC=AWS_AP_SOUTH_1
SCYLLA_TLS=true
SCYLLA_CA_CERT_PATH=/etc/scylla2ch/certs/scylla-cloud-ca.pem
# OR use base64-encoded PEM for Kubernetes secrets / env injection:
# SCYLLA_CA_CERT_BASE64=LS0tLS1CRUdJTi...

# --- ClickHouse Cloud ---
CH_HOST=your-cluster.clickhouse.cloud
CH_PORT=9440
CH_DATABASE=my_database
CH_USER=default
CH_PASSWORD=
CH_TLS=true

# --- CDC ---
CDC_MODE=delta
CDC_CONFIDENCE_WINDOW=5s
CDC_QUERY_WINDOW=1m
CDC_CHANGE_AGE_LIMIT=8h
CDC_CHECKPOINT_INTERVAL=60s

# --- Batch ---
BATCH_SIZE=10000
BATCH_INTERVAL=5s
BATCH_RETRY_MAX=3
BATCH_RETRY_BACKOFF=500ms

# --- Tables ---
# auto_discover: true to auto-detect CDC-enabled tables (no config needed)
# auto_create: true to auto-create ClickHouse tables from ScyllaDB schema
# discover_interval: hot-reload interval — new CDC tables detected + streamed without restart
TABLES_AUTO_DISCOVER=true
TABLES_AUTO_CREATE=true
TABLES_DISCOVER_INTERVAL=30s

# --- Observability ---
METRICS_PORT=9090
METRICS_PATH=/metrics
HEALTH_PORT=8080
